{
  "name": "caustica",
  "version": "0.1.0",
  "private": true,
  "description": "Four-minute Caustica proof demonstration with editable Remotion source and native hybrid master.",
  "scripts": {
    "studio": "remotion studio src/index.ts --port 3417",
    "stills": "remotion still src/index.ts CausticaPoster output/Caustica_Demo_Poster.png --gl=swangle",
    "check": "tsc --noEmit",
    "lint": "node scripts/lint-film.mjs src --strict",
    "cues": "tsx scripts/export-cues.ts --sync src/demo-sync.ts --timeline src/demo-timeline.ts --out qa/cues.json",
    "graphics": "node scripts/render-graphics.mjs",
    "motion": "node scripts/export-motion.mjs",
    "render": "node scripts/render-hybrid.mjs",
    "render:remotion": "node scripts/render-final.mjs",
    "render:draft": "node scripts/render-final.mjs --draft",
    "qa": "node scripts/py.mjs scripts/qa.py",
    "listen": "node scripts/py.mjs scripts/audio/listen.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "remotion": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@remotion/bundler": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0"
  }
}
